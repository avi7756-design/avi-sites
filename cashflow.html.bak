<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>💰 תזרים מזומנים - נכסים | אבי חזן</title>
<meta name="theme-color" content="#2e7d32">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="תזרים נכסים">
<style>
  :root{
    --ink:#10261a; --bg:#eef5ef; --card:#fff; --line:#d3e4d8; --muted:#5d7066;
    --green:#2e7d32; --green-d:#1b5e20; --red:#c0392b; --amber:#e08e0b; --blue:#2c6ca5; --gold:#c9a25a;
    --shadow:0 2px 12px rgba(20,50,30,.09);
  }
  *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif;}
  body{background:var(--bg);color:var(--ink);line-height:1.6;padding:0 0 90px;-webkit-tap-highlight-color:transparent;}
  header{background:linear-gradient(135deg,var(--green-d),var(--green));color:#fff;padding:20px 16px 16px;text-align:center;box-shadow:var(--shadow);}
  header h1{font-size:22px;}
  header p{font-size:12.5px;opacity:.9;margin-top:3px;}
  .wrap{max-width:820px;margin:0 auto;padding:16px 14px;}
  .summary{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:18px;}
  .sumcard{background:var(--card);border:1px solid var(--line);border-radius:13px;padding:12px 6px;text-align:center;box-shadow:var(--shadow);}
  .sumcard .n{font-size:20px;font-weight:bold;}
  .sumcard .l{font-size:10.5px;color:var(--muted);margin-top:2px;}
  .n.pos{color:var(--green);} .n.neg{color:var(--red);} .n.blue{color:var(--blue);} .n.gold{color:#a07a1f;}
  .prop{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:15px;margin-bottom:14px;box-shadow:var(--shadow);border-right:5px solid var(--green);}
  .prop.late{border-right-color:var(--red);}
  .prop.unpaid{border-right-color:var(--amber);}
  .prop h3{font-size:17px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;}
  .prop .addr{font-size:12px;color:var(--muted);font-weight:normal;}
  .pstat{font-size:11px;font-weight:bold;padding:3px 10px;border-radius:20px;}
  .ps-paid{background:#e6f4ea;color:var(--green);} .ps-late{background:#fdeaea;color:var(--red);} .ps-wait{background:#fff7e8;color:var(--amber);}
  .pgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:12px 0;}
  .pbox{background:var(--bg);border-radius:10px;padding:9px 6px;text-align:center;}
  .pbox .v{font-size:16px;font-weight:bold;} .pbox .k{font-size:10.5px;color:var(--muted);}
  .prow{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px;}
  .btn{border:none;border-radius:10px;padding:9px 14px;font-size:13px;font-weight:bold;cursor:pointer;color:#fff;background:var(--green);font-family:inherit;}
  .btn:active{transform:scale(.97);}
  .btn.sm{padding:6px 11px;font-size:12px;} .btn.gray{background:#7a8a80;} .btn.blue{background:var(--blue);} .btn.red{background:var(--red);} .btn.amber{background:var(--amber);}
  .btn.wide{width:100%;margin-top:6px;}
  .add{background:var(--card);border:2px dashed var(--line);border-radius:16px;padding:16px;text-align:center;margin-bottom:16px;}
  label{display:block;font-size:12px;font-weight:bold;color:var(--muted);margin:8px 0 3px;text-align:right;}
  input{width:100%;padding:9px;border:1px solid #b9cdc0;border-radius:9px;font-family:inherit;font-size:14px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:9px;}
  .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;padding:16px;overflow:auto;}
  .overlay.show{display:block;}
  .modal{max-width:540px;margin:24px auto;background:var(--card);border-radius:16px;padding:18px;box-shadow:0 12px 50px rgba(0,0,0,.35);}
  .modal h2{color:var(--green-d);font-size:18px;margin-bottom:6px;}
  .modal .x{float:left;background:var(--red);color:#fff;border:none;border-radius:50%;width:30px;height:30px;font-size:15px;cursor:pointer;}
  .hint{font-size:12px;color:var(--muted);background:#f4faf5;border:1px solid #cfe6d6;border-radius:10px;padding:9px 12px;margin-bottom:14px;}
  .exprow{display:flex;justify-content:space-between;font-size:12.5px;padding:3px 0;color:var(--muted);}
  footer{text-align:center;font-size:11px;color:var(--muted);margin-top:12px;}
</style>
</head>
<body>
<header>
  <h1>💰 תזרים מזומנים - נכסים</h1>
  <p id="hdrSub">מעקב הכנסות, הוצאות ורווח לכל דירה · נשמר במכשיר</p>
</header>

<div class="wrap">
  <div class="hint">📅 חודש נוכחי: <b id="curMonth"></b>. סמן "שולם" כשהשוכר משלם. הנתונים נשמרים בדפדפן הזה - מאובטח ופרטי.</div>

  <div class="summary" id="summary"></div>

  <div id="props"></div>

  <div class="add">
    <button class="btn" onclick="openAdd()">➕ הוסף נכס</button>
    <div style="font-size:12px;color:var(--muted);margin-top:8px">הוסף כל דירה שאתה משכיר</div>
  </div>

  <button class="btn gray wide" onclick="exportData()">📤 ייצוא גיבוי (JSON)</button>
  <footer>תזרים נכסים · v1.0 · נשמר מקומית בדפדפן · אבי חזן</footer>
</div>

<!-- מודאל הוספה/עריכה -->
<div class="overlay" id="ov"><div class="modal" id="modal"></div></div>

<script>
var KEY='cashflow_properties_v1';
var MONTHS=['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
function monthKey(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');}
function monthLabel(){var d=new Date();return MONTHS[d.getMonth()]+' '+d.getFullYear();}
function fmt(n){return Math.round(n||0).toLocaleString('he-IL');}
function load(){try{return JSON.parse(localStorage.getItem(KEY))||[];}catch(e){return [];}}
function save(a){localStorage.setItem(KEY,JSON.stringify(a));}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6);}

// זריעה ראשונית - הדירה שהושכרה
function seedIfEmpty(){
  var a=load();
  if(a.length===0){
    a.push({id:uid(),name:'אחי אילת 5',addr:'קריית חיים מזרחית',price:0,rent:3700,dueDay:1,
      exp:{mortgage:0,vaad:411,arnona:0,insurance:0,maintenance:0,other:0},payments:{}});
    save(a);
  }
}
function totalExp(p){var e=p.exp||{};return (+e.mortgage||0)+(+e.vaad||0)+(+e.arnona||0)+(+e.insurance||0)+(+e.maintenance||0)+(+e.other||0);}
function netMonthly(p){return (+p.rent||0)-totalExp(p);}
function payStatus(p){
  var mk=monthKey();var st=(p.payments||{})[mk]||'';
  if(st==='paid')return 'paid';
  var today=new Date().getDate();
  if(today>(+p.dueDay||1)+3)return 'late'; // עברו 3 ימים מהמועד
  return 'wait';
}

function render(){
  var a=load();
  document.getElementById('curMonth').textContent=monthLabel();
  // סיכום
  var totRent=0,totExp=0,totNet=0,totPrice=0;
  a.forEach(function(p){totRent+=(+p.rent||0);totExp+=totalExp(p);totNet+=netMonthly(p);totPrice+=(+p.price||0);});
  var yieldPct=totPrice>0?(totNet*12/totPrice*100):0;
  document.getElementById('summary').innerHTML=
    sc(fmt(totRent)+' ₪','blue','💵 שכ"ד/חודש')+
    sc(fmt(totExp)+' ₪','neg','💳 הוצאות/חודש')+
    sc(fmt(totNet)+' ₪',(totNet>=0?'pos':'neg'),'✅ נטו/חודש')+
    sc((totPrice>0?yieldPct.toFixed(1)+'%':'–'),'gold','📈 תשואה');
  // נכסים
  var html='';
  if(a.length===0){html='<div class="hint" style="text-align:center">אין נכסים עדיין. לחץ "הוסף נכס".</div>';}
  a.forEach(function(p,i){
    var st=payStatus(p);var net=netMonthly(p);
    var stTxt=st==='paid'?'✅ שולם החודש':(st==='late'?'🔴 באיחור!':'🟡 ממתין לתשלום');
    var stCls=st==='paid'?'ps-paid':(st==='late'?'ps-late':'ps-wait');
    var gross=(+p.price>0)?((+p.rent*12/+p.price*100).toFixed(1)+'%'):'–';
    var netY=(+p.price>0)?((net*12/+p.price*100).toFixed(1)+'%'):'–';
    html+='<div class="prop '+(st==='late'?'late':(st==='wait'?'unpaid':''))+'">'+
      '<h3>'+esc(p.name)+' <span class="pstat '+stCls+'">'+stTxt+'</span></h3>'+
      '<div class="addr">'+esc(p.addr||'')+' · תשלום ב-'+(p.dueDay||1)+' לחודש</div>'+
      '<div class="pgrid">'+
        pb(fmt(p.rent)+' ₪','שכ"ד')+pb(fmt(totalExp(p))+' ₪','הוצאות')+pb(fmt(net)+' ₪','נטו')+
      '</div>'+
      '<div style="font-size:12px;color:var(--muted);text-align:center">תשואה ברוטו '+gross+' · נטו '+netY+(+p.price>0?' (על '+fmt(p.price)+' ₪)':' (הזן מחיר רכישה לתשואה)')+'</div>'+
      '<div class="prow">'+
        (st!=='paid'?'<button class="btn sm" onclick="markPaid('+i+')">✅ סמן שולם</button>':'<button class="btn sm gray" onclick="unmark('+i+')">בטל סימון</button>')+
        '<button class="btn sm blue" onclick="openEdit('+i+')">✏️ ערוך</button>'+
        '<button class="btn sm gray" onclick="hist('+i+')">📜 היסטוריה</button>'+
      '</div></div>';
  });
  document.getElementById('props').innerHTML=html;
}
function sc(n,cls,l){return '<div class="sumcard"><div class="n '+cls+'">'+n+'</div><div class="l">'+l+'</div></div>';}
function pb(v,k){return '<div class="pbox"><div class="v">'+v+'</div><div class="k">'+k+'</div></div>';}
function esc(s){return (s||'').replace(/[<>&"]/g,function(c){return({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'})[c];});}

function markPaid(i){var a=load();a[i].payments=a[i].payments||{};a[i].payments[monthKey()]='paid';save(a);render();}
function unmark(i){var a=load();if(a[i].payments)delete a[i].payments[monthKey()];save(a);render();}

function openAdd(){editForm(null);}
function openEdit(i){editForm(i);}
function editForm(i){
  var a=load();var p=(i!==null)?a[i]:{name:'',addr:'',price:0,rent:0,dueDay:1,exp:{mortgage:0,vaad:0,arnona:0,insurance:0,maintenance:0,other:0}};
  var e=p.exp||{};
  document.getElementById('modal').innerHTML=
   '<button class="x" onclick="closeOv()">✕</button>'+
   '<h2>'+(i!==null?'✏️ עריכת נכס':'➕ נכס חדש')+'</h2>'+
   '<label>שם הנכס</label><input id="f_name" value="'+esc(p.name)+'" placeholder="למשל: אחי אילת 5">'+
   '<label>כתובת</label><input id="f_addr" value="'+esc(p.addr||'')+'" placeholder="עיר / שכונה">'+
   '<div class="row2"><div><label>מחיר רכישה (₪)</label><input id="f_price" type="number" inputmode="numeric" value="'+(p.price||'')+'"></div>'+
   '<div><label>שכ"ד חודשי (₪)</label><input id="f_rent" type="number" inputmode="numeric" value="'+(p.rent||'')+'"></div></div>'+
   '<label>יום תשלום בחודש (1-31)</label><input id="f_due" type="number" inputmode="numeric" value="'+(p.dueDay||1)+'">'+
   '<h2 style="font-size:15px;margin:14px 0 4px">💳 הוצאות חודשיות</h2>'+
   '<div class="row2">'+
     '<div><label>משכנתא</label><input id="f_mortgage" type="number" inputmode="numeric" value="'+(e.mortgage||'')+'"></div>'+
     '<div><label>ועד בית</label><input id="f_vaad" type="number" inputmode="numeric" value="'+(e.vaad||'')+'"></div>'+
     '<div><label>ארנונה</label><input id="f_arnona" type="number" inputmode="numeric" value="'+(e.arnona||'')+'"></div>'+
     '<div><label>ביטוח</label><input id="f_insurance" type="number" inputmode="numeric" value="'+(e.insurance||'')+'"></div>'+
     '<div><label>תחזוקה</label><input id="f_maintenance" type="number" inputmode="numeric" value="'+(e.maintenance||'')+'"></div>'+
     '<div><label>אחר</label><input id="f_other" type="number" inputmode="numeric" value="'+(e.other||'')+'"></div>'+
   '</div>'+
   '<button class="btn wide" onclick="saveProp('+(i!==null?i:'-1')+')">💾 שמור</button>'+
   (i!==null?'<button class="btn red wide" onclick="delProp('+i+')">🗑️ מחק נכס</button>':'');
  document.getElementById('ov').classList.add('show');
}
function v(id){var e=document.getElementById(id);return e?e.value.trim():'';}
function nv(id){return +v(id)||0;}
function saveProp(i){
  var a=load();
  var p={id:(i>-1&&a[i])?a[i].id:uid(),name:v('f_name')||'נכס',addr:v('f_addr'),price:nv('f_price'),rent:nv('f_rent'),dueDay:nv('f_due')||1,
    exp:{mortgage:nv('f_mortgage'),vaad:nv('f_vaad'),arnona:nv('f_arnona'),insurance:nv('f_insurance'),maintenance:nv('f_maintenance'),other:nv('f_other')},
    payments:(i>-1&&a[i])?(a[i].payments||{}):{}};
  if(i>-1)a[i]=p;else a.push(p);
  save(a);closeOv();render();
}
function delProp(i){if(!confirm('למחוק את הנכס לצמיתות?'))return;var a=load();a.splice(i,1);save(a);closeOv();render();}
function hist(i){
  var a=load();var p=a[i];var pm=p.payments||{};var keys=Object.keys(pm).sort().reverse();
  var rows=keys.length?keys.map(function(k){var parts=k.split('-');return '<div class="exprow"><span>'+MONTHS[(+parts[1])-1]+' '+parts[0]+'</span><b style="color:var(--green)">'+(pm[k]==='paid'?'✅ שולם':pm[k])+'</b></div>';}).join(''):'<div style="color:var(--muted);font-size:13px">אין היסטוריית תשלומים עדיין.</div>';
  document.getElementById('modal').innerHTML='<button class="x" onclick="closeOv()">✕</button><h2>📜 היסטוריית תשלומים</h2><div style="font-weight:bold;margin-bottom:8px">'+esc(p.name)+'</div>'+rows;
  document.getElementById('ov').classList.add('show');
}
function closeOv(){document.getElementById('ov').classList.remove('show');}
function exportData(){
  var data=localStorage.getItem(KEY)||'[]';
  var blob=new Blob([data],{type:'application/json'});var url=URL.createObjectURL(blob);
  var a=document.createElement('a');a.href=url;a.download='cashflow_backup_'+monthKey()+'.json';a.click();
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeOv();});
seedIfEmpty();render();
</script>
<script src="nav.js"></script>
<script src="help.js"></script>
</body>
</html>
