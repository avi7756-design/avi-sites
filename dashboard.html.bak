<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>📊 דשבורד לידים חי - אחי אילת 5</title>
<style>
  :root{--bg:#f4f1ea;--card:#fff;--ink:#2c2c2a;--muted:#6b6b66;--accent:#c1764c;--green:#2e7d32;--red:#c0392b;--gold:#c9a25a;--blue:#2c6ca5;--purple:#7e57c2;--line:#e3ddd0;}
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--ink);padding:14px;line-height:1.5;}
  .wrap{max-width:1000px;margin:0 auto;}
  header{text-align:center;margin-bottom:14px;}
  header h1{font-size:22px;color:var(--accent);}
  header .sub{color:var(--muted);font-size:12px;margin-top:2px;}
  .bar{display:flex;gap:8px;justify-content:center;margin-bottom:16px;flex-wrap:wrap;}
  .btn{padding:9px 18px;border:none;border-radius:10px;font-size:14px;font-weight:bold;cursor:pointer;font-family:inherit;color:#fff;text-decoration:none;display:inline-block;}
  .btn.refresh{background:var(--accent);} .btn.add{background:var(--green);} .btn.home{background:var(--purple);}
  .btn.sm{padding:6px 12px;font-size:12px;}
  .btn.ok{background:var(--green);} .btn.red{background:var(--red);} .btn.gray{background:#8a7a68;} .btn.wa{background:#25d366;} .btn.blue{background:var(--blue);}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;margin-bottom:18px;}
  .kpi{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 8px;text-align:center;}
  .kpi .num{font-size:26px;font-weight:bold;color:var(--accent);}
  .kpi .lbl{font-size:12px;color:var(--muted);margin-top:2px;}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:16px;}
  .panel h2{font-size:16px;color:var(--accent);margin-bottom:10px;}
  table{width:100%;border-collapse:collapse;font-size:13px;}
  th,td{text-align:right;padding:8px 6px;border-bottom:1px solid var(--line);}
  th{color:var(--muted);font-size:11px;background:#faf7f0;}
  tr.clk{cursor:pointer;} tr.clk:hover{background:#faf6ee;}
  .pill{display:inline-block;padding:2px 9px;border-radius:12px;font-size:11px;font-weight:bold;}
  .s-new{background:#e7f0fa;color:var(--blue);} .s-talk{background:#fcf3e0;color:#a87d1d;}
  .s-visit{background:#eef0ff;color:#5a4ab7;} .s-want{background:#e6f4ea;color:var(--green);}
  .s-closed{background:var(--green);color:#fff;} .s-no{background:#f0eee8;color:var(--muted);}
  .p-high{color:var(--green);font-weight:bold;} .p-mid{color:#a87d1d;} .p-low{color:var(--muted);}
  .src-bar-row{display:flex;align-items:center;gap:8px;margin:4px 0;font-size:13px;}
  .src-bar{height:18px;background:var(--accent);border-radius:5px;min-width:4px;}
  .loading{text-align:center;color:var(--muted);padding:30px;}
  .err{text-align:center;color:var(--red);padding:20px;background:#fdeaea;border-radius:10px;}
  .note{font-size:11px;color:var(--muted);text-align:center;margin-top:10px;}
  a.tel{color:var(--blue);text-decoration:none;font-weight:bold;}
  .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;padding:20px;overflow:auto;}
  .overlay.show{display:block;}
  .modal{max-width:560px;margin:30px auto;background:var(--bg);border-radius:16px;padding:20px;box-shadow:0 10px 40px rgba(0,0,0,.3);}
  .modal h2{color:var(--accent);font-size:19px;margin-bottom:4px;}
  .modal .x{float:left;background:var(--red);color:#fff;border:none;border-radius:50%;width:32px;height:32px;font-size:16px;cursor:pointer;}
  .modal label{font-size:12px;color:var(--muted);display:block;margin:6px 0 2px;}
  .modal input,.modal select,.modal textarea{width:100%;padding:8px;border:1px solid #ccc;border-radius:8px;font-family:inherit;font-size:13px;}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#2e7d32;color:#fff;padding:12px 24px;border-radius:30px;font-weight:bold;opacity:0;transition:.3s;z-index:120;}
  .toast.show{opacity:1;}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>📊 דשבורד לידים חי</h1>
    <div class="sub">דירה אחי אילת 5 · מתעדכן אוטומטית מהמערכת · <span id="ts">טוען...</span></div>
  </header>

  <div class="bar">
    <a class="btn home" href="manage.html">🎯 מרכז ניהול (ראשי)</a>
    <button class="btn refresh" onclick="load()">🔄 רענן נתונים</button>
    <span id="lastUpd" style="align-self:center;font-size:12px;color:var(--muted);font-weight:bold;">עודכן לאחרונה: --:--</span>
    <a class="btn add" href="https://avi7756-design.github.io/avi-sites/lead-entry.html" target="_blank">📥 רשום ליד חדש</a>
  </div>

  <div class="kpis" id="kpis"></div>

  <div class="panel">
    <h2>📍 לידים לפי מקור</h2>
    <div id="sources"><div class="loading">טוען...</div></div>
  </div>

  <div class="panel">
    <h2>📋 כל הלידים · לחץ על ליד כדי לערוך או למחוק</h2>
    <div id="table"><div class="loading">טוען לידים...</div></div>
  </div>

  <div class="note">המערכת מושכת ישירות מטבלת הלידים. עריכה/מחיקה כאן מתעדכנת בכל המסכים אוטומטית.</div>
</div>

<div class="overlay" id="ov"><div class="modal" id="modal"></div></div>
<div class="toast" id="toast">בוצע ✓</div>

<script>
const API='https://avi-hazan.app.n8n.cloud/webhook/leads-data-eilat5';
const UPD='https://avi-hazan.app.n8n.cloud/webhook/lead-update-eilat5';
const DEL='https://avi-hazan.app.n8n.cloud/webhook/lead-delete-eilat5';
const SRCS=['יד2','Meta Ads','פייסבוק','פייסבוק קבוצות','עמוד נחיתה','לוחות','המלצה','אחר'];
const STATS=['פנייה חדשה','דיברנו','ביקור נקבע','ביקר','מעוניין','סגרנו חוזה','לא מתאים'];
const POTS=['גבוה','בינוני','נמוך'];
let ROWS=[];

const statusClass=s=>({'פנייה חדשה':'s-new','חדש':'s-new','דיברנו':'s-talk','ביקור נקבע':'s-visit','ביקר':'s-visit','מעוניין':'s-want','סגרנו חוזה':'s-closed','לא מתאים':'s-no'}[s]||'s-new');
const potClass=p=>({'גבוה':'p-high','בינוני':'p-mid','נמוך':'p-low'}[p]||'p-mid');
function fmtDate(d){if(!d)return '-';const x=new Date(d);return x.toLocaleDateString('he-IL')+' '+x.toLocaleTimeString('he-IL',{hour:'2-digit',minute:'2-digit'});}
function esc(s){return (s||'').replace(/[<>&"]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));}
function toast(t){var e=document.getElementById('toast');e.textContent=t||'בוצע ✓';e.classList.add('show');setTimeout(()=>e.classList.remove('show'),1500);}
function val(id){var e=document.getElementById(id);return e?e.value.trim():'';}
function opts(arr,cur){return arr.map(o=>'<option'+(o===(cur||'').trim()?' selected':'')+'>'+o+'</option>').join('');}
function closeModal(){document.getElementById('ov').classList.remove('show');}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});

function load(){
  document.getElementById('ts').textContent='מרענן...';
  var lu0=document.getElementById('lastUpd');if(lu0)lu0.textContent='מרענן...';
  fetch(API+'?t='+Date.now(),{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}).then(rows=>{
    if(!Array.isArray(rows)) rows=[];
    ROWS=rows; render(rows);
    lastLoad=Date.now();
    var hhmm=new Date().toLocaleTimeString('he-IL',{hour:'2-digit',minute:'2-digit'});
    document.getElementById('ts').textContent='עודכן '+hhmm;
    var lu=document.getElementById('lastUpd');if(lu)lu.textContent='עודכן לאחרונה: '+hhmm;
  }).catch(e=>{
    document.getElementById('table').innerHTML='<div class="err">❌ לא ניתן לטעון לידים. סיבות אפשריות: (1) מכסת ההרצות ב-n8n נגמרה - בדוק ב-app.n8n.cloud, (2) אין אינטרנט. הנתונים עצמם שמורים ולא נמחקו.</div>';
    document.getElementById('ts').textContent='שגיאה';
    var lue=document.getElementById('lastUpd');if(lue)lue.textContent='⚠️ שגיאת רענון';
  });
}
function render(rows){
  const total=rows.length;
  const closed=rows.filter(r=>r.status==='סגרנו חוזה').length;
  const visited=rows.filter(r=>['ביקר','מעוניין','סגרנו חוזה'].includes(r.status)).length;
  const high=rows.filter(r=>r.potential==='גבוה').length;
  const active=rows.filter(r=>!['לא מתאים','סגרנו חוזה'].includes(r.status)).length;
  document.getElementById('kpis').innerHTML=kpi(total,'סה"כ לידים')+kpi(active,'פעילים')+kpi(high,'פוטנציאל גבוה')+kpi(visited,'ביקרו/מעוניינים')+kpi(closed,'נסגרו');
  const bySrc={};rows.forEach(r=>{const s=r.source||'לא ידוע';bySrc[s]=(bySrc[s]||0)+1;});
  const max=Math.max(1,...Object.values(bySrc));let sh='';
  Object.entries(bySrc).sort((a,b)=>b[1]-a[1]).forEach(([s,n])=>{sh+=`<div class="src-bar-row"><span style="min-width:120px;">${esc(s)}</span><div class="src-bar" style="width:${(n/max)*180}px;"></div><b>${n}</b></div>`;});
  document.getElementById('sources').innerHTML=sh||'<div class="loading">אין נתונים עדיין</div>';
  if(!rows.length){document.getElementById('table').innerHTML='<div class="loading">אין לידים עדיין. רשום את הראשון! 📥</div>';return;}
  let t='<table><tr><th>תאריך</th><th>שם</th><th>טלפון</th><th>מקור</th><th>סטטוס</th><th>פוטנציאל</th><th>הערה</th></tr>';
  rows.forEach((r,i)=>{
    t+=`<tr class="clk" onclick="openLead(${i})">
      <td>${fmtDate(r.createdAt)}</td>
      <td>${esc(r.name)||'-'}</td>
      <td><a class="tel" href="tel:${(r.phone||'').replace(/\s/g,'')}" onclick="event.stopPropagation()">${esc(r.phone)||'-'}</a></td>
      <td>${esc(r.source)||'-'}</td>
      <td><span class="pill ${statusClass(r.status)}">${esc(r.status)||'-'}</span></td>
      <td class="${potClass(r.potential)}">${esc(r.potential)||'-'}</td>
      <td style="max-width:200px;font-size:12px;color:#6b6b66;">${esc(r.notes)}</td>
    </tr>`;
  });
  t+='</table>';
  document.getElementById('table').innerHTML=t;
}
function kpi(n,l){return `<div class="kpi"><div class="num">${n}</div><div class="lbl">${l}</div></div>`;}

function openLead(i){
  var r=ROWS[i];var tel=(r.phone||'').replace(/[^0-9]/g,'');var wa=tel.replace(/^0/,'972');
  var nm=(r.name||'').replace(/'/g,'’');
  document.getElementById('modal').innerHTML=
   '<button class="x" onclick="closeModal()">✕</button>'+
   '<h2>'+esc(r.name||'ליד')+'</h2>'+
   '<p style="font-size:12px;color:var(--muted)">נכנס: '+fmtDate(r.createdAt)+' · מזהה #'+r.id+'</p>'+
   '<div style="display:flex;gap:6px;flex-wrap:wrap;margin:8px 0">'+
    (tel?'<a class="btn sm blue" href="tel:'+tel+'">📞 חייג</a><a class="btn sm wa" href="https://wa.me/'+wa+'" target="_blank">💬 וואטסאפ</a>':'')+
    '<button class="btn sm red" onclick="del('+r.id+',\''+nm+'\')">🗑️ מחק ליד</button>'+
   '</div>'+
   '<label>שם</label><input id="e_name" value="'+esc(r.name||'')+'">'+
   '<label>טלפון</label><input id="e_phone" value="'+esc(r.phone||'')+'">'+
   '<label>מקור</label><select id="e_source">'+opts(SRCS,r.source)+'</select>'+
   '<label>סטטוס</label><select id="e_status">'+opts(STATS,r.status)+'</select>'+
   '<label>פוטנציאל</label><select id="e_pot">'+opts(POTS,r.potential)+'</select>'+
   '<label>הערה</label><textarea id="e_notes" style="min-height:60px">'+esc(r.notes||'')+'</textarea>'+
   '<div style="margin-top:10px"><button class="btn ok" onclick="save('+r.id+')">💾 שמור שינויים</button></div>';
  document.getElementById('ov').classList.add('show');
}
function save(id){
  var p={id:id,name:val('e_name'),phone:val('e_phone'),source:val('e_source'),status:val('e_status'),potential:val('e_pot'),notes:val('e_notes')};
  toast('שומר...');
  fetch(UPD,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)})
   .then(()=>{setTimeout(()=>{load();closeModal();toast('נשמר ועודכן בכל המסכים ✓');},1200);})
   .catch(()=>toast('שגיאה בשמירה'));
}
function del(id,name){
  if(!confirm('למחוק את הליד "'+name+'"?\nבלתי הפיך, ויעודכן בכל המסכים.'))return;
  toast('מוחק...');
  fetch(DEL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})})
   .then(()=>{setTimeout(()=>{load();closeModal();toast('נמחק ✓');},1200);})
   .catch(()=>toast('שגיאה במחיקה'));
}
let lastLoad=Date.now();
load();
document.addEventListener('visibilitychange',()=>{if(!document.hidden&&Date.now()-lastLoad>600000){load();}});
</script>
<footer style="font-size:10px;color:#999;text-align:center;padding:10px 0;">גרסה <span id="siteVer"></span></footer>
<script src="version.js"></script>
<script>(function(){if(window.SITE_VERSION){document.getElementById('siteVer').textContent=SITE_VERSION.num+' · '+SITE_VERSION.date+' '+SITE_VERSION.time;}})();</script>
<script src="nav.js"></script>
<script src="help.js"></script>
</body>
</html>
