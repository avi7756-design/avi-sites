<title>יומן אירועים והחלטות — AVI HUNTER</title>
<style>
:root{color-scheme:light}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Segoe UI",Arial,sans-serif;background:#eef1f7;color:#1a2030;line-height:1.6;padding:16px}
.doc{max-width:900px;margin:0 auto;background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(20,30,60,.08);overflow:hidden}
.hdr{background:linear-gradient(135deg,#15233f,#23386a);color:#fff;padding:24px 30px}
.hdr h1{font-size:21px;margin-bottom:4px}
.hdr .sub{font-size:12.5px;color:#aebdd4}
.body{padding:20px 30px}
h2{font-size:16px;color:#23386a;margin:22px 0 10px;padding-bottom:5px;border-bottom:2px solid #e6eaf3}
h2:first-child{margin-top:0}
p{font-size:13px;margin-bottom:7px}
.aibox{background:#f4f0ff;border:1px solid #d6c8f5;border-radius:12px;padding:14px 16px;font-size:13px}
.aibox b{color:#5b3aa0}
.tools{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
button{cursor:pointer;border:none;border-radius:9px;font-size:12.5px;font-weight:600;padding:8px 14px;font-family:inherit}
.btn-go{background:#2563eb;color:#fff}
.btn-f{background:#eef2fb;color:#2247a8}
.btn-f.on{background:#2563eb;color:#fff}
.card{border-right:4px solid #9aa0a6;background:#f8fafd;border-radius:0 12px 12px 0;padding:13px 16px;margin-bottom:11px}
.card .top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:5px}
.card .ts{font-size:11.5px;color:#6b7488;font-weight:700}
.tag{font-size:10px;font-weight:700;padding:2px 9px;border-radius:20px}
.card .node{font-size:14.5px;font-weight:700;color:#15233f;margin-bottom:4px}
.card .dec{font-size:13px;margin-bottom:3px}
.card .why{font-size:12.5px;color:#444;margin-bottom:3px}
.card .alt{font-size:12px;color:#777;margin-bottom:3px}
.card .ref{font-size:11.5px}
.card .ref a{color:#2247a8}
.strategy{border-right-color:#2f6fd0}.strategy .tag{background:#e3edfb;color:#2247a8}
.exec{border-right-color:#1d7a44}.exec .tag{background:#eafaf0;color:#1d7a44}
.fault{border-right-color:#c0334a}.fault .tag{background:#fdeef0;color:#b3243c}
.research{border-right-color:#9e6a03}.research .tag{background:#fff7e6;color:#9a6b13}
.chk{display:flex;align-items:flex-start;gap:8px;padding:7px 10px;border-radius:8px;background:#f7f9fd;margin-bottom:5px;font-size:13px;border:1px solid #eef1f8}
.chk.done{background:#eafaf0;border-color:#bfe9cf}
.chk .m{flex-shrink:0}
.reflist{font-size:12.5px;columns:2;column-gap:24px}
.reflist a{color:#2247a8;display:block;margin-bottom:4px}
@media(max-width:560px){.reflist{columns:1}}
.foot{padding:14px 30px;background:#f5f8fd;border-top:1px solid #e6eaf3;font-size:11px;color:#7a8398;text-align:center}
@media print{body{background:#fff;padding:0}.doc{box-shadow:none}}
</style>
</head>
